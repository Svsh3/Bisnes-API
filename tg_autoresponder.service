[Unit]
Description=Telegram Business AutoResponder Bot
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/tg_autoresponder
ExecStart=/home/ubuntu/tg_autoresponder/venv/bin/python main.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
